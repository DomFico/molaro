# What the PACKAGED extension ships. The runtime is: dist/ (the bundled
# extension host + webview JS) plus the Python the host spawns at run time
# (producer/*.py, which imports contract/contract.py). Everything else — source
# that's already bundled into dist/, tests, screenshot evidence, fixtures — is
# excluded so the .vsix stays small.

# Screenshot evidence + scale artifacts (regenerated by the test suites).
reports/**
media/**

# Lane working artifacts — one-off probes, gate logs, capture scaffolds. NOT a
# runtime path and never imported by dist/. This rule closes a real ship defect,
# not a hypothetical one: vsce packages the FILESYSTEM (it consults
# .vscodeignore, not git), so untracked scratch files shipped too. Measured
# before this rule: viewer-0.1.0-win32-x64.vsix carried 148 `extension/
# scratchpad/*` entries, and the INSTALLED extension at
# ~/.vscode/extensions/undefined_publisher.viewer-0.1.0/scratchpad/ held 60
# top-level entries / 148 files — i.e. every VSIX packaged and installed on
# 2026-07-26 shipped the lanes' probe scripts into the running extension.
scratchpad/**

# Tests and their fixtures (not run inside the installed extension).
tests/**
contract/fixtures/**

# Source already bundled into dist/ (esbuild): the extension host + webview TS.
src/**
webview/**
contract/*.ts
contract/SPEC.md

# Python bytecode caches.
**/__pycache__/**
**/*.pyc

# Build/editor/project cruft not needed at runtime.
.vscode/**
.gitignore
tsconfig.json
*.vsix
producer/CONTRACT_FIT_AUDIT.md
HANDOFF*.md

# Workspace mod examples — .molaro/ is USER-WORKSPACE data (the extension
# loads mods from the opened workspace, not from itself).
.molaro/**
